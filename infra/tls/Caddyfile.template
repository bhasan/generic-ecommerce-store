# ============================================================================
# Caddy multi-tenant TLS template  (alternative to nginx — recommended once you
# have more than a handful of tenant CUSTOM domains)
# ----------------------------------------------------------------------------
# Why Caddy here: it issues and renews certificates automatically, including
# ON-DEMAND TLS for arbitrary custom domains — so a tenant pointing their own
# domain at you "just works" with zero per-domain config or nginx reloads. The
# app still resolves the tenant from the Host header; Caddy passes it through.
#
# Replace yourapp.com and the DNS provider block before use.
# ============================================================================

{
	email ops@yourapp.com

	# On-demand TLS: Caddy will obtain a cert the first time it sees an unknown
	# hostname (a tenant custom domain) — BUT it must ask your app whether that
	# host is a real, active tenant first, or anyone could point a domain at you
	# and make you mint certs. The `ask` endpoint must return 200 only for known
	# custom domains. Add a tiny backend route for this (see the guide).
	on_demand_tls {
		ask http://backend:3000/api/internal/tls-allowed
		interval 2m
		burst 5
	}
}

# ----------------------------------------------------------------------------
# A. Apex + all platform subdomains — wildcard cert via DNS-01.
#    Requires a DNS-provider plugin build of Caddy (e.g. caddy-dns/cloudflare)
#    and CF_API_TOKEN in the environment.
# ----------------------------------------------------------------------------
yourapp.com, *.yourapp.com {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
	import app
}

# ----------------------------------------------------------------------------
# B. Tenant custom domains — on-demand TLS, no per-domain config.
#    The empty site block with `tls on_demand` is the catch-all for any other
#    hostname; the `ask` endpoint above gates which ones are allowed.
# ----------------------------------------------------------------------------
https:// {
	tls {
		on_demand
	}
	import app
}

# ----------------------------------------------------------------------------
# Shared handling for every site above.  Host is forwarded automatically by
# reverse_proxy, which is what carries tenant identity to the app.
# ----------------------------------------------------------------------------
(app) {
	# Block external access to backend metrics.
	@metrics path /metrics
	respond @metrics 403

	handle /api/* {
		reverse_proxy backend:3000 {
			header_up X-Request-Id {http.request.uuid}
			# Host, X-Forwarded-For, X-Forwarded-Proto are set by reverse_proxy by default.
		}
	}

	# SPA static files + client-side router fallback.
	handle {
		root * /usr/share/nginx/html
		try_files {path} /index.html
		file_server
	}

	request_body {
		max_size 10MB
	}
	encode gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}
