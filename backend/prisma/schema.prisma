generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int                        @id @default(autoincrement())
  username              String                     @unique
  password              String
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  approved              Boolean                    @default(false)
  cashapp               String?
  zelle                 String?
  venmo                 String?
  phoneNumber           String?
  address               String?
  rejected              Boolean                    @default(false)
  rejectionNote         String?
  creditBalance         Decimal                    @default(0) @db.Decimal(12, 2)
  deliveryStatus        DeliveryZoneStatus?
  deliverySource        DeliveryEligibilitySource?
  deliveryDistanceMiles Float?
  deliveryCheckedAt     DateTime?

  userRoles                 UserRole[]
  orders                    Order[]
  creditTransactions        CreditTransaction[] @relation("CreditUser")
  createdCreditTransactions CreditTransaction[] @relation("CreditCreatedBy")
  reviews                   Review[]
  reviewVotes               ReviewVote[]
  notifications             Notification[]
  contactMessages           ContactMessage[]

  @@map("users")
}

model Role {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    Int
  roleId    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Order {
  id                     Int                        @id @default(autoincrement())
  userId                 Int
  status                 OrderStatus                @default(PENDING)
  subtotal               Decimal                    @default(0) @db.Decimal(12, 2)
  tax                    Decimal                    @default(0) @db.Decimal(12, 2)
  deliveryFee            Decimal                    @default(0) @db.Decimal(12, 2)
  discountTotal          Decimal                    @default(0) @db.Decimal(12, 2)
  total                  Decimal                    @db.Decimal(12, 2)
  taxRate                Decimal                    @default(0) @db.Decimal(6, 4)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  deliveryMethod         DeliveryMethodEnum         @default(DELIVERY)
  paymentMethod          PaymentMethodEnum          @default(EXTERNAL)
  transactionId          String?                    @unique
  deliveryAddress        String?
  vehicleDescription     String?
  parkingSpot            String?
  paymentHandle          String?
  deliveryStatus         DeliveryZoneStatus?
  deliverySource         DeliveryEligibilitySource?
  deliveryDistanceMiles  Float?
  deliveryThresholdMiles Float?
  deliveryCheckedAt      DateTime?

  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  creditTransactions CreditTransaction[]
  contactMessages    ContactMessage[]
  printJobs          PrintJob[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model AddressGeocodeCache {
  id                Int      @id @default(autoincrement())
  normalizedAddress String   @unique
  formattedAddress  String
  latitude          Float
  longitude         Float
  city              String?
  state             String?
  zipCode           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("address_geocode_cache")
}

model CreditTransaction {
  id            Int                   @id @default(autoincrement())
  userId        Int
  amount        Decimal               @db.Decimal(12, 2)
  balanceAfter  Decimal               @db.Decimal(12, 2)
  type          CreditTransactionType
  orderId       Int?
  note          String?
  createdBy     Int?
  createdAt     DateTime              @default(now())
  user          User                  @relation("CreditUser", fields: [userId], references: [id], onDelete: Restrict)
  createdByUser User?                 @relation("CreditCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  order         Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("credit_transactions")
}

model OrderItem {
  id                   Int      @id @default(autoincrement())
  orderId              Int
  productId            Int
  quantity             Float
  price                Float
  voided               Boolean  @default(false)
  addedAfterSubmission Boolean  @default(false)
  createdAt            DateTime @default(now())

  @@map("order_items")
}

model Category {
  id                Int           @id @default(autoincrement())
  name              String
  description       String?
  parentId          Int?
  sortOrder         Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  allowedQuantities Float[]       @default([])
  quantityDiscounts Json?
  parent            Category?     @relation("CategoryParent", fields: [parentId], references: [id])
  children          Category[]    @relation("CategoryParent")
  products          ProductItem[]

  @@unique([name, parentId])
  @@map("categories")
}

model ProductItem {
  id                        Int      @id @default(autoincrement())
  name                      String
  price                     Float
  description               String?
  thumbnail                 String?
  image                     String?
  images                    String[]
  stock                     Float    @default(0)
  stockEnabled              Boolean  @default(true)
  hidden                    Boolean  @default(false)
  vipOnly                   Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  categoryId                Int
  sortOrder                 Int      @default(0)
  cardSize                  String   @default("standard")
  allowedQuantitiesOverride Float[]  @default([])
  quantityDiscountsOverride Json?
  category                  Category @relation(fields: [categoryId], references: [id])

  @@map("products")
}

model UiSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ui_settings")
}

model Review {
  id         Int          @id @default(autoincrement())
  userId     Int
  productId  Int
  rating     Int
  comment    String
  helpful    Int          @default(0)
  notHelpful Int          @default(0)
  flagged    Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes      ReviewVote[]

  @@unique([userId, productId])
  @@index([productId])
  @@map("reviews")
}

model ReviewVote {
  id        Int            @id @default(autoincrement())
  reviewId  Int
  userId    Int
  kind      ReviewVoteKind
  createdAt DateTime       @default(now())
  review    Review         @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@map("review_votes")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  quantity  Float
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("cart_items")
}

model Announcement {
  id          Int              @id @default(autoincrement())
  message     String
  type        AnnouncementType @default(INFO)
  enabled     Boolean          @default(true)
  dismissible Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("announcements")
}

model ContactMessage {
  id            Int                  @id @default(autoincrement())
  userId        Int?
  userName      String
  userEmail     String
  userPhone     String?
  subject       String
  orderId       Int?
  message       String
  status        ContactMessageStatus @default(NEW)
  adminNotes    String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  repliedAt     DateTime?
  repliedBy     Int?
  repliedByName String?
  replyMessage  String?
  user          User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  order         Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@map("contact_messages")
}

model Notification {
  id                Int                        @id @default(autoincrement())
  recipientUserId   Int
  type              NotificationType
  category          NotificationCategory
  title             String
  message           String
  metadata          Json?
  sourceEntityType  NotificationEntityType?
  sourceEntityId    Int?
  requiresAttention Boolean                    @default(false)
  readAt            DateTime?
  deliveredAt       DateTime?
  deliveryStatus    NotificationDeliveryStatus @default(PENDING)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  recipient         User                       @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, createdAt])
  @@index([recipientUserId, readAt])
  @@map("notifications")
}

model PrintJob {
  id               Int            @id @default(autoincrement())
  orderId          Int
  reason           PrintJobReason
  status           PrintJobStatus @default(PENDING)
  payloadJson      Json
  createdAt        DateTime       @default(now())
  claimedAt        DateTime?
  completedAt      DateTime?
  failedAt         DateTime?
  claimedByAgentId String?
  nativeJobId      String?
  attemptCount     Int            @default(0)
  lastErrorCode    String?
  lastErrorMessage String?
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([claimedByAgentId])
  @@map("print_jobs")
}

enum OrderStatus {
  PENDING_PAYMENT
  PENDING
  APPROVED
  NOT_FULFILLING
  READY_FOR_DELIVERY
  OUT_FOR_DELIVERY
  DELIVERED
  READY_FOR_PICKUP
  ARRIVED
  PICKED_UP
}

enum AnnouncementType {
  INFO
  WARNING
  SUCCESS
}

enum ContactMessageStatus {
  NEW
  READ
  RESOLVED
}

enum NotificationType {
  ORDER_CREATED
  ORDER_STATUS_UPDATED
  REGISTRATION_SUBMITTED
  ACCOUNT_APPROVED
  ACCOUNT_REJECTED
  CONTACT_MESSAGE_RECEIVED
  CONTACT_REPLY_SENT
}

enum NotificationCategory {
  ORDERS
  AUTH
  CONTACT
  DRIVER
  ADMIN
}

enum NotificationEntityType {
  ORDER
  USER
  CONTACT_MESSAGE
}

enum NotificationDeliveryStatus {
  PENDING
  DELIVERED
  DISABLED
  FAILED
}

enum CreditTransactionType {
  ADDED
  USED
  REFUNDED
  REMOVED
}

enum ReviewVoteKind {
  HELPFUL
  NOT_HELPFUL
}

enum DeliveryMethodEnum {
  DELIVERY
  PICKUP
  CURBSIDE
}

enum PaymentMethodEnum {
  EXTERNAL
  CREDIT
  IN_STORE
  CC
}

enum DeliveryZoneStatus {
  IN_ZONE
  OUT_OF_ZONE
  UNVERIFIED
}

enum DeliveryEligibilitySource {
  GOOGLE_GEOCODING
  ADDRESS_CACHE
  ZIP_FALLBACK
  NONE
}

enum PrintJobReason {
  ORDER_CREATED
  MANUAL_REPRINT
}

enum PrintJobStatus {
  PENDING
  CLAIMED
  PRINTED
  FAILED
}
