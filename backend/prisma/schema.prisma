// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  output        = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model with role-based access control
model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  password      String    // Hashed with bcrypt
  name          String
  address       String?   // Optional delivery address
  cashapp       String?   // Optional CashApp handle (payment method)
  phoneNumber   String?   // Optional 5-star rewards phone number
  approved      Boolean   @default(false) // Admin approval status
  rejected      Boolean   @default(false) // Rejection status
  rejectionNote String?   // Optional note explaining rejection
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model Role {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("roles")
}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    Int
  roleId    Int
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@map("user_roles")
}

// Order model
model Order {
  id        Int         @id @default(autoincrement())
  userId    Int
  status    OrderStatus @default(PENDING)
  total     Float
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("orders")
}

enum OrderStatus {
  PENDING
  APPROVED
  NOT_FULFILLING
  READY_FOR_DELIVERY
  OUT_FOR_DELIVERY
  DELIVERED
}

enum AnnouncementType {
  INFO
  WARNING
  SUCCESS
}

// Order item model with void tracking
model OrderItem {
  id                   Int      @id @default(autoincrement())
  orderId              Int
  productId            Int
  quantity             Float
  price                Float    // Price at time of order
  voided               Boolean  @default(false)
  addedAfterSubmission Boolean  @default(false)
  createdAt            DateTime @default(now())

  @@map("order_items")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  parentId    Int?
  sortOrder   Int       @default(0)
  allowedQuantities Float[] @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryParent")
  products ProductItem[]

  @@unique([name, parentId])
  @@map("categories")
}

// Enhanced ProductItem model (renamed from Product)
model ProductItem {
  id           Int         @id @default(autoincrement())
  name         String
  categoryId   Int
  price        Float
  description  String?
  image        String?     // Primary image URL
  images       String[]    // Array of image URLs
  stock        Float       @default(0)
  stockEnabled Boolean     @default(true)
  hidden       Boolean     @default(false)
  sortOrder    Int         @default(0)
  cardSize     String      @default("standard")
  allowedQuantitiesOverride Float[] @default([])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  category     Category    @relation(fields: [categoryId], references: [id])

  @@map("products")
}

model UiSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ui_settings")
}

// Review model
model Review {
  id                Int      @id @default(autoincrement())
  userId            Int
  productId         Int
  rating            Int      // 1-5
  comment           String
  helpful           Int      @default(0)
  notHelpful        Int      @default(0)
  flagged           Boolean  @default(false)
  votedByHelpful    Int[]    // Array of user IDs who voted helpful
  votedByNotHelpful Int[]    // Array of user IDs who voted not helpful
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("reviews")
}

// Shopping cart model
model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  quantity  Float
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("cart_items")
}

// Announcement model
model Announcement {
  id          Int               @id @default(autoincrement())
  message     String
  type        AnnouncementType  @default(INFO)
  enabled     Boolean           @default(true)
  dismissible Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("announcements")
}
