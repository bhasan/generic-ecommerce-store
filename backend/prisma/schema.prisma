generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        Int                       @id @default(autoincrement())
  username                  String                    @unique
  password                  String
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  approved                  Boolean                   @default(false)
  cashapp                   String?
  zelle                     String?
  venmo                     String?
  phoneNumber               String?
  address                   String?
  rejected                  Boolean                   @default(false)
  rejectionNote             String?
  creditBalance             Float                     @default(0)
  deliveryZoneStatus        DeliveryZoneStatus?
  deliveryZoneSource        DeliveryEligibilitySource?
  deliveryZoneDistanceMiles Float?
  deliveryZoneCheckedAt     DateTime?

  @@map("users")
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    Int
  roleId    Int
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Order {
  id                        Int                       @id @default(autoincrement())
  userId                    Int
  status                    OrderStatus               @default(PENDING)
  total                     Float
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  deliveryMethod            String                    @default("DELIVERY")
  paymentMethod             String                    @default("EXTERNAL")
  transactionId             String?                   @unique
  deliveryAddress           String?
  vehicleDescription        String?
  parkingSpot               String?
  paymentHandle             String?
  deliveryZoneStatus        DeliveryZoneStatus?
  deliveryEligibilitySource DeliveryEligibilitySource?
  deliveryDistanceMiles     Float?
  deliveryThresholdMiles    Float?
  deliveryZoneCheckedAt     DateTime?

  @@map("orders")
}

model AddressGeocodeCache {
  id                Int      @id @default(autoincrement())
  normalizedAddress String   @unique
  formattedAddress  String
  latitude          Float
  longitude         Float
  city              String?
  state             String?
  zipCode           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("address_geocode_cache")
}

model CreditTransaction {
  id        Int                   @id @default(autoincrement())
  userId    Int
  amount    Float
  type      CreditTransactionType
  orderId   Int?
  note      String?
  createdBy Int?
  createdAt DateTime              @default(now())

  @@map("credit_transactions")
}

model OrderItem {
  id                   Int      @id @default(autoincrement())
  orderId              Int
  productId            Int
  quantity             Float
  price                Float
  voided               Boolean  @default(false)
  addedAfterSubmission Boolean  @default(false)
  createdAt            DateTime @default(now())

  @@map("order_items")
}

model Category {
  id                Int           @id @default(autoincrement())
  name              String
  description       String?
  parentId          Int?
  sortOrder         Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  allowedQuantities Float[]       @default([])
  quantityDiscounts Json?
  parent            Category?     @relation("CategoryParent", fields: [parentId], references: [id])
  children          Category[]    @relation("CategoryParent")
  products          ProductItem[]

  @@unique([name, parentId])
  @@map("categories")
}

model ProductItem {
  id                        Int      @id @default(autoincrement())
  name                      String
  price                     Float
  description               String?
  thumbnail                 String?
  image                     String?
  images                    String[]
  stock                     Float    @default(0)
  stockEnabled              Boolean  @default(true)
  hidden                    Boolean  @default(false)
  vipOnly                   Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  categoryId                Int
  sortOrder                 Int      @default(0)
  cardSize                  String   @default("standard")
  allowedQuantitiesOverride Float[]  @default([])
  quantityDiscountsOverride Json?
  category                  Category @relation(fields: [categoryId], references: [id])

  @@map("products")
}

model UiSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ui_settings")
}

model Review {
  id                Int      @id @default(autoincrement())
  userId            Int
  productId         Int
  rating            Int
  comment           String
  helpful           Int      @default(0)
  notHelpful        Int      @default(0)
  flagged           Boolean  @default(false)
  votedByHelpful    Int[]
  votedByNotHelpful Int[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("reviews")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  quantity  Float
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("cart_items")
}

model Announcement {
  id          Int              @id @default(autoincrement())
  message     String
  type        AnnouncementType @default(INFO)
  enabled     Boolean          @default(true)
  dismissible Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("announcements")
}

model ContactMessage {
  id            Int                  @id @default(autoincrement())
  userId        Int
  userName      String
  userEmail     String
  userPhone     String?
  subject       String
  orderId       Int?
  message       String
  status        ContactMessageStatus @default(NEW)
  adminNotes    String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  repliedAt     DateTime?
  repliedBy     Int?
  repliedByName String?
  replyMessage  String?

  @@map("contact_messages")
}

model Notification {
  id               Int                        @id @default(autoincrement())
  recipientUserId  Int
  type             NotificationType
  category         NotificationCategory
  title            String
  message          String
  metadata         Json?
  sourceEntityType NotificationEntityType?
  sourceEntityId   Int?
  requiresAttention Boolean                  @default(false)
  readAt           DateTime?
  deliveredAt      DateTime?
  deliveryStatus   NotificationDeliveryStatus @default(PENDING)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@index([recipientUserId, createdAt])
  @@index([recipientUserId, readAt])
  @@map("notifications")
}

model PrintJob {
  id               Int            @id @default(autoincrement())
  orderId          Int            @map("order_id")
  reason           PrintJobReason
  status           PrintJobStatus @default(PENDING)
  payloadJson      Json           @map("payload_json")
  createdAt        DateTime       @default(now()) @map("created_at")
  claimedAt        DateTime?      @map("claimed_at")
  completedAt      DateTime?      @map("completed_at")
  failedAt         DateTime?      @map("failed_at")
  claimedByAgentId String?        @map("claimed_by_agent_id")
  nativeJobId      String?        @map("native_job_id")
  attemptCount     Int            @default(0) @map("attempt_count")
  lastErrorCode    String?        @map("last_error_code")
  lastErrorMessage String?        @map("last_error_message")

  @@index([status, createdAt])
  @@index([claimedByAgentId])
  @@map("print_jobs")
}

enum OrderStatus {
  PENDING_PAYMENT
  PENDING
  APPROVED
  NOT_FULFILLING
  READY_FOR_DELIVERY
  OUT_FOR_DELIVERY
  DELIVERED
  READY_FOR_PICKUP
  ARRIVED
  PICKED_UP
}

enum AnnouncementType {
  INFO
  WARNING
  SUCCESS
}

enum ContactMessageStatus {
  NEW
  READ
  RESOLVED
}

enum NotificationType {
  ORDER_CREATED
  ORDER_STATUS_UPDATED
  REGISTRATION_SUBMITTED
  ACCOUNT_APPROVED
  ACCOUNT_REJECTED
  CONTACT_MESSAGE_RECEIVED
  CONTACT_REPLY_SENT
}

enum NotificationCategory {
  ORDERS
  AUTH
  CONTACT
  DRIVER
  ADMIN
}

enum NotificationEntityType {
  ORDER
  USER
  CONTACT_MESSAGE
}

enum NotificationDeliveryStatus {
  PENDING
  DELIVERED
  DISABLED
  FAILED
}

enum CreditTransactionType {
  ADDED
  USED
  REFUNDED
  REMOVED
}

enum DeliveryZoneStatus {
  IN_ZONE
  OUT_OF_ZONE
  UNVERIFIED
}

enum DeliveryEligibilitySource {
  GOOGLE_GEOCODING
  ADDRESS_CACHE
  ZIP_FALLBACK
  NONE
}

enum PrintJobReason {
  ORDER_CREATED
  MANUAL_REPRINT
}

enum PrintJobStatus {
  PENDING
  CLAIMED
  PRINTED
  FAILED
}
