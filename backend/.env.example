# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/smoke_station?schema=public"

# Postgres connection pool (appended to DATABASE_URL by the app if not already present)
# Tune to (num_app_instances * DB_CONNECTION_LIMIT) <= Postgres max_connections.
DB_CONNECTION_LIMIT=10
DB_POOL_TIMEOUT=20

# TTL (ms) for the in-process settings cache. Warm reads skip the DB entirely.
# Lower values mean more DB traffic but fresher config; 0 or non-numeric disables caching (falls back to 30000ms).
SETTINGS_CACHE_TTL_MS=30000

# Production: keep in sync with root .env.prod (compose builds DATABASE_URL from these)
# DB_USER=
# DB_PASSWORD=
# DB_NAME=

# Production seed: optional admin display name (defaults to DB_USER or "Admin")
# ADMIN_NAME=

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="24h"

# Server Configuration
PORT=3000
NODE_ENV="development"
# Request timeout in milliseconds
REQUEST_TIMEOUT_MS=30000

# CORS Configuration
CORS_ORIGIN="*"
# For production, use specific origins:
# CORS_ORIGIN="https://yourdomain.com,https://www.yourdomain.com"

# Rate limiting / proxy
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000
GENERAL_RATE_LIMIT_MAX=100
GENERAL_RATE_LIMIT_WINDOW_MS=900000
POLL_RATE_LIMIT_MAX=240
POLL_RATE_LIMIT_WINDOW_MS=900000
# Keep one trusted proxy hop when Nginx is directly in front of the backend.
TRUST_PROXY_HOPS=1
# Optional debug sampling for real-IP verification after deploy (set LOG_LEVEL=debug to emit).
REQUEST_IP_DEBUG_SAMPLE_SIZE=5

# Exteral APIs
#
# Google Geocoding powers delivery radius verification. If this key is missing or
# expired, the backend intentionally falls back to the offline ZIP allowlist when
# that fallback is enabled in ordering constraints.
GOOGLE_GEOCODING_API_KEY=""

# Contact Form Webhook (Make.com)
# Required for contact form to work
# Put live values in backend/.env, not in this tracked example file.
MAKE_WEBHOOK_URL="https://hook.make.com/your-webhook-id"
MAKE_API_KEY="your-make-api-key"

# Notification Webhooks (Make.com)
# V1 can share the same Make scenario as the contact email flow.
# Branch inside Make using payload fields such as eventType, category, and channelIntent.
# If these notification-specific vars are left empty, the app falls back to MAKE_WEBHOOK_URL.
# Keep live webhook values in backend/.env.
MAKE_NOTIFICATION_WEBHOOK_URL="https://hook.make.com/your-notification-webhook-id"
# Optional category-specific overrides
# MAKE_NOTIFICATION_WEBHOOK_URL_ORDERS="https://hook.make.com/orders-webhook-id"
# MAKE_NOTIFICATION_WEBHOOK_URL_AUTH="https://hook.make.com/auth-webhook-id"
# MAKE_NOTIFICATION_WEBHOOK_URL_CONTACT="https://hook.make.com/contact-webhook-id"
# MAKE_NOTIFICATION_WEBHOOK_URL_DRIVER="https://hook.make.com/driver-webhook-id"
# MAKE_NOTIFICATION_WEBHOOK_URL_ADMIN="https://hook.make.com/admin-webhook-id"

# Thermal printer queue
# The backend stores print jobs for a local Windows print agent to poll and print.
# The print agent sends this shared key in x-print-agent-key when claiming/completing jobs.
PRINT_AGENT_SHARED_KEY=""
THERMAL_PRINTER_STORE_NAME="Smoke Station"

# Authorize.net CC Payments
# The hosted-payment iframe callback URL is derived from CORS_ORIGIN
# (see resolveCommunicatorUrl in order.service.ts) — no separate FRONTEND_URL needed.
# AES-256-GCM key for encrypting CC payment credentials at rest (32 bytes as 64-char hex)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_ENCRYPTION_KEY=""

# AES-256-GCM key for encrypting POS credentials at rest (32 bytes as 64-char hex)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POS_ENCRYPTION_KEY=""

# POS outbox worker tuning (optional — defaults shown)
# How often the worker polls for pending outbox rows (milliseconds)
POS_OUTBOX_POLL_MS=30000
# How long a row can stay in PROCESSING before it's considered orphaned and reclaimed (milliseconds)
POS_OUTBOX_LEASE_MS=300000

# Online Store Reporting API
# Disabled by default until endpoints and payloads pass local tests.
ONLINE_STORE_REPORTING_API_ENABLED=false
ONLINE_STORE_REPORTING_API_TOKEN=
ONLINE_STORE_REPORTING_API_MAX_PAGE_SIZE=250
ONLINE_STORE_REPORTING_API_DEFAULT_PAGE_SIZE=100
ONLINE_STORE_REPORTING_API_RATE_LIMIT_PER_MINUTE=120
ONLINE_STORE_REPORTING_API_INCLUDE_CUSTOMERS=false
ONLINE_STORE_REPORTING_API_INCLUDE_PAYMENT_DETAILS=false
ONLINE_STORE_REPORTING_API_SCHEMA_VERSION=2026-06-online-store-reporting-v1

# Logging (optional, defaults to info)
# LOG_LEVEL=debug

# Google Geocoding (optional, defaults to 5000 ms)
# GOOGLE_GEOCODING_TIMEOUT_MS=5000

# POS order outbox backlog alert threshold (optional, defaults to 50)
# POS_OUTBOX_BACKLOG_THRESHOLD=50
