# Database Configuration
DB_USER=backend_user
DB_PASSWORD=change-me-in-production
DB_NAME=smoke-station-delivery-db

# JWT Configuration (Backend)
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=24h

# CORS Configuration (Backend)
# Set to your frontend URL in production
CORS_ORIGIN=http://localhost:3000

# Rate Limiting (Backend)
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000
GENERAL_RATE_LIMIT_MAX=100
GENERAL_RATE_LIMIT_WINDOW_MS=900000
POLL_RATE_LIMIT_MAX=240
POLL_RATE_LIMIT_WINDOW_MS=900000
TRUST_PROXY_HOPS=1

# Port Configuration (Production)
HTTP_PORT=80
HTTPS_PORT=443

# Optional: Cloudflare Dynamic DNS
CF_DDNS_API_TOKEN=
CF_DDNS_ZONE_ID=

# Optional: SSL Certificates Path (Production)
# Mount these from ./nginx/ssl/
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
