# Copy this file to .env.prod and set real values before building/running production.
# Then use: docker compose -f docker-compose.prod.yml --env-file .env.prod build
#           docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# Database (used by db and backend services)
DB_USER=
DB_PASSWORD=
DB_NAME=

# JWT (backend)
JWT_SECRET=
JWT_EXPIRES_IN=24h

# CORS (backend) - e.g. https://yourdomain.com
CORS_ORIGIN=

# Dynamic DNS (Cloudflare) - optional, for cloudflare-ddns service
CF_DDNS_API_TOKEN=
CF_DDNS_ZONE_ID=

# Optional
AUTH_RATE_LIMIT_MAX=20
HTTP_PORT=80
HTTPS_PORT=443
