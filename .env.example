# Database Configuration (used by docker-compose to build DATABASE_URL)
DB_USER=backend_user
DB_PASSWORD=change-me-in-production
DB_NAME=smoke-station-delivery-db

# Port Configuration (Production)
HTTP_PORT=80
HTTPS_PORT=443

# Optional: Cloudflare Dynamic DNS
CF_DDNS_API_TOKEN=
CF_DDNS_ZONE_ID=

# Optional: SSL Certificates Path (Production)
# Mount these from ./nginx/ssl/
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Grafana Cloud — Loki (log aggregation)
# Get these from: grafana.com → My Account → Stack → Loki → Details
LOKI_URL=
LOKI_USERNAME=
LOKI_PASSWORD=

# Grafana Cloud — Prometheus (metrics)
# Get these from: grafana.com → My Account → Stack → Prometheus → Details
PROMETHEUS_REMOTE_WRITE_URL=
PROMETHEUS_USERNAME=
PROMETHEUS_PASSWORD=
