# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# AI related files
.claude/*

# Environment files and local snapshots (secrets; use .env.example as template)
.env*
!**/.env.example

# Cloudflare DDNS config (contains zone_id; use config-example.json as template)
cloudflare-ddns/config.json

# SSL certificates
nginx/ssl/
*.pem
*.key
*.crt

# Backups
*.sql
!backend/prisma/migrations/**/*.sql
backups/

# Local Docker image exports
docker/

# Uploaded files (product images, etc.)
backend/uploads/

# Generated validation reports
build/
tests/live/playwright-report/
tests/live/test-results/
tests/live/reports/*
!tests/live/reports/.gitkeep

# Ensure Prisma migrations are tracked
!backend/prisma/migrations/
!backend/prisma/migrations/**/*.sql
test-results/
